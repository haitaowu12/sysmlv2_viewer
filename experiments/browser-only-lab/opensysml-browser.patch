diff --git a/internal/frontend/core/core.go b/internal/frontend/core/core.go
index a25c123..7ee6f72 100644
--- a/internal/frontend/core/core.go
+++ b/internal/frontend/core/core.go
@@ -18,0 +19 @@ import (
+	"github.com/Open-MBEE/OpenSysML/internal/translate/convert"
@@ -102,0 +104,65 @@ func (c *Core) Call(ctx context.Context, method string, params []byte) (result [
+    case "Convert":
+        var req struct { ModelHash string `json:"modelHash"`; ToFormat string `json:"toFormat"` }
+        if err := jsonrpc.Decode(params, &req); err != nil { return nil, err }
+        if req.ToFormat != "api-json" { return nil, jsonrpc.Errorf(jsonrpc.CodeUnimplemented, "Lab trial only exposes api-json export") }
+        model, ok := c.get(req.ModelHash)
+        if !ok { return nil, jsonrpc.Errorf(jsonrpc.CodeNotFound, msgModelNotFound, req.ModelHash) }
+        if len(model.documents) != 1 { return nil, jsonrpc.Errorf(jsonrpc.CodeUnimplemented, "Lab trial supports one source document") }
+        for _, d := range modelDiagnostics(model) { if d.Severity == "error" { return nil, jsonrpc.Errorf(jsonrpc.CodeFailedPrecondition, "Invalid model cannot export a snapshot") } }
+        document := model.documents[0]
+        content, err := convert.Convert(document.source.Name(), document.source.Bytes(), convert.FormatSysML, convert.FormatAPIJSON)
+        if err != nil { return nil, err }
+        var elements []map[string]any
+        if err := json.Unmarshal(content, &elements); err != nil { return nil, err }
+        byName := map[string]any{}
+        for _, el := range elements { if name, ok := el["qualifiedName"].(string); ok { byName[name]=el["@id"] } }
+        identity := func(sym *symbols.Symbol) (any, bool) {
+            if sym == nil { return nil, false }
+            if id, ok := byName[model.index.GetFQN(sym)]; ok { return id, true }
+            // An unnamed declared flow has no lookup name; match its engine span.
+            if sym.DocName == document.source.Name() && sym.Kind.String() == "flowUsage" {
+                pos := document.source.Lines().PosAt(sym.DeclSpan.Offset)
+                for _, el := range elements { if el["@type"] == "FlowUsage" && el["sysx:sourceLine"] == float64(pos.Line) && el["sysx:sourceColumn"] == float64(pos.Col) { return el["@id"], true } }
+            }
+            return nil, false
+        }
+        byID := map[any]map[string]any{}
+        for _, el := range elements { byID[el["@id"]]=el }
+        semantic := model.symbolContext().Semantics
+        for _, el := range elements {
+            name, _ := el["qualifiedName"].(string)
+            matches := symbolfacts.LookupNamed(model.index, name)
+            if len(matches) != 1 || name == "" { continue }
+            sym := matches[0]
+            for _, field := range []string{"isComposite", "isReference", "isAbstract", "isOrdered", "isUnique"} {
+                if value, ok := semantic.ReflectiveFeatureValue(sym, field); ok && value.Kind == symbols.FilterValueBool { el[field]=value.Bool }
+            }
+            if features, ok := semantic.ReflectiveElements(sym, "feature"); ok {
+                refs := []map[string]any{}
+                missing := []string{}
+                libraryExcluded := 0
+                for _, feature := range features {
+                    if feature.DocName != document.source.Name() { libraryExcluded++; continue }
+                    if id, ok := identity(feature); ok { refs=append(refs,map[string]any{"@id":id}) } else { missing=append(missing,model.index.GetFQN(feature)) }
+                }
+                el["feature"]=refs
+                el["featureLibraryExcluded"]=libraryExcluded
+                if len(missing)>0 { el["lab:unmappedFeatureRefs"]=missing } else { delete(el,"lab:unmappedFeatureRefs") }
+            }
+            // Preserve the engine's implicit redefinition of typed connector roles.
+            if ends, ok := semantic.OwnedConnectorEnds(sym); ok {
+                encoded, _ := el["connectorEnd"].([]any)
+                if len(ends)==len(encoded) {
+                    for i, nativeEnd := range ends {
+                        ref, _ := encoded[i].(map[string]any)
+                        target := byID[ref["@id"]]
+                        roles := semantic.ImplicitEndRedefinitions(nativeEnd)
+                        if target != nil && len(roles)==1 { target["lab:roleName"]=roles[0].Name }
+                    }
+                }
+            }
+        }
+        content, err = json.Marshal(elements)
+        if err != nil { return nil, err }
+        return json.Marshal(map[string]any{"content":string(content)})
+
