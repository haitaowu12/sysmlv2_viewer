+// Copyright 2025 Open‐MBEE Foundation. All rights reserved.
+// Use of this source code is governed by the LICENSE file.
+// Modified for the maintained Modeling Lab: typed export regression and capture.
+package core
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+func labTestExport(t *testing.T, source string) []map[string]any {
+	t.Helper()
+	c, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	request, _ := json.Marshal(map[string]any{"content": source, "strictConformance": true})
+	parsed, err := c.Call(context.Background(), "ParseFile", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var p JParseFileResponse
+	if err = json.Unmarshal(parsed, &p); err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range p.Diagnostics {
+		if d.Severity == "error" {
+			t.Fatalf("invalid fixture: %s", parsed)
+		}
+	}
+	request, _ = json.Marshal(map[string]any{"modelHash": p.ModelHash, "toFormat": "api-json"})
+	converted, err := c.Call(context.Background(), "Convert", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result struct {
+		Content string `json:"content"`
+	}
+	if err = json.Unmarshal(converted, &result); err != nil {
+		t.Fatal(err)
+	}
+	var elements []map[string]any
+	if err = json.Unmarshal([]byte(result.Content), &elements); err != nil {
+		t.Fatal(err)
+	}
+	return elements
+}
+
+// Developer semantic capture through the same Core calls used by WebAssembly.
+func TestLabCapture(t *testing.T) {
+	path := os.Getenv("LAB_TEST_SOURCE")
+	if path == "" {
+		t.Skip("set LAB_TEST_SOURCE for a fixture capture")
+	}
+	src, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	elements := labTestExport(t, string(src))
+	if out := os.Getenv("LAB_TEST_OUTPUT"); out != "" {
+		data, err := json.Marshal(elements)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(out, data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestLabTypedStateAndOccurrenceFacts(t *testing.T) {
+	elements := labTestExport(t, `package LabFacts {
+ part def Device;
+ part def Area { part unit : Device; }
+ part def Plant { part east : Area; part west : Area; }
+ part plant : Plant;
+ requirement r { subject device : Device; require constraint { true } }
+ satisfy r by plant.east.unit;
+ assert not satisfy r by plant.west.unit;
+ verification def V { subject device : Device; objective { verify r; } }
+ verification def UnknownVerification { subject device : Device; }
+ state def Sequential { entry; then a; state a; state b; transition move first a then b; }
+ state def Concurrent parallel { state a; state b; }
+}`)
+	byName := map[string]map[string]any{}
+	byID := map[any]map[string]any{}
+	for _, el := range elements {
+		if name, ok := el["qualifiedName"].(string); ok {
+			byName[name] = el
+		}
+		byID[el["@id"]] = el
+	}
+	if got := byName["LabFacts::Sequential"]["isParallel"]; got != false {
+		t.Fatalf("sequential isParallel = %v", got)
+	}
+	if got := byName["LabFacts::Concurrent"]["isParallel"]; got != true {
+		t.Fatalf("parallel isParallel = %v", got)
+	}
+	transition := byName["LabFacts::Sequential::move"]
+	if transition["lab:transitionFieldsComplete"] != true {
+		t.Fatalf("typed transition incomplete: %v", transition)
+	}
+	for _, field := range []string{"triggerAction", "guardExpression", "effectAction"} {
+		if values, ok := transition[field].([]any); !ok || len(values) != 0 {
+			t.Fatalf("%s = %v, expected explicitly empty", field, transition[field])
+		}
+	}
+	roots := map[string]bool{}
+	negative, positive := 0, 0
+	for _, el := range elements {
+		if el["@type"] != "SatisfyRequirementUsage" {
+			continue
+		}
+		switch el["isNegated"] {
+		case true:
+			negative++
+		case false:
+			positive++
+		default:
+			t.Fatalf("missing polarity: %v", el)
+		}
+		chain, ok := el["lab:subjectChain"].([]any)
+		if !ok || len(chain) != 3 {
+			t.Fatalf("rooted occurrence chain missing: %v", el)
+		}
+		middle := chain[1].(map[string]any)["@id"]
+		roots[byID[middle]["qualifiedName"].(string)] = true
+		if _, ok := el["satisfyingFeature"].(map[string]any); !ok {
+			t.Fatalf("missing exact satisfier: %v", el)
+		}
+		if _, ok := el["satisfiedRequirement"].(map[string]any); !ok {
+			t.Fatalf("missing requirement: %v", el)
+		}
+	}
+	if negative != 1 || positive != 1 || !roots["LabFacts::Plant::east"] || !roots["LabFacts::Plant::west"] {
+		t.Fatalf("polarity or occurrence collapse: %d/%d %v", negative, positive, roots)
+	}
+	verified, ok := byName["LabFacts::V"]["verifiedRequirement"].([]any)
+	if !ok || len(verified) != 1 {
+		t.Fatalf("verification objective not resolved: %v", byName["LabFacts::V"])
+	}
+	if _, invented := byName["LabFacts::UnknownVerification"]["verifiedRequirement"]; invented {
+		t.Fatal("verification without a declared objective acquired a verified requirement")
+	}
+	if _, invented := byName["LabFacts::Device"]["isParallel"]; invented {
+		t.Fatal("non-state declaration acquired a state default")
+	}
+	for _, el := range elements {
+		if el["@type"] == "StateSubactionMembership" {
+			if _, invented := el["memberElement"]; invented {
+				t.Fatal("empty entry acquired an invented action")
+			}
+		}
+	}
+}
+
+func TestLabSubjectChainRetainsRepeatedFeatureSteps(t *testing.T) {
+	elements := labTestExport(t, `package Repeated {
+ part def Node { ref part next : Node; }
+ part root : Node;
+ requirement r { subject item : Node; require constraint { true } }
+ satisfy r by root.next.next;
+}`)
+	names := map[any]string{}
+	for _, el := range elements {
+		if name, ok := el["qualifiedName"].(string); ok {
+			names[el["@id"]] = name
+		}
+	}
+	found := false
+	for _, el := range elements {
+		if el["@type"] != "SatisfyRequirementUsage" {
+			continue
+		}
+		found = true
+		chain, ok := el["lab:subjectChain"].([]any)
+		if !ok || len(chain) != 3 {
+			t.Fatalf("recursive occurrence chain lost a step: %v", el["lab:subjectChain"])
+		}
+		expected := []string{"Repeated::root", "Repeated::Node::next", "Repeated::Node::next"}
+		for i, ref := range chain {
+			id := ref.(map[string]any)["@id"]
+			if names[id] != expected[i] {
+				t.Fatalf("chain step %d = %s, expected %s", i, names[id], expected[i])
+			}
+		}
+	}
+	if !found {
+		t.Fatal("fixture satisfaction declaration was not exported")
+	}
+}
