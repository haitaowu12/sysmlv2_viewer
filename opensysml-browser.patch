+func TestLabDocumentationUsesTypedRelationship(t *testing.T) {
+	elements := labTestExport(t, `package DocumentationFacts {
+ part def Other;
+ requirement r {
+  doc /* The device shall retain the stated information. */
+  comment about Other /* This comment describes Other, not the requirement. */
+  require constraint { true }
+ }
+ requirement undocumented { require constraint { true } }
+}`)
+	byName := map[string]map[string]any{}
+	byID := map[any]map[string]any{}
+	for _, el := range elements {
+		if name, ok := el["qualifiedName"].(string); ok {
+			byName[name] = el
+		}
+		byID[el["@id"]] = el
+	}
+	docs, ok := byName["DocumentationFacts::r"]["documentation"].([]any)
+	if !ok || len(docs) != 1 {
+		t.Fatalf("typed documentation relationship missing or comment included: %v", byName["DocumentationFacts::r"]["documentation"])
+	}
+	doc := byID[docs[0].(map[string]any)["@id"]]
+	if doc["@type"] != "Documentation" || doc["body"] != "The device shall retain the stated information. " {
+		t.Fatalf("wrong documentation target: %v", doc)
+	}
+	for _, name := range []string{"DocumentationFacts::Other", "DocumentationFacts::undocumented"} {
+		if values, ok := byName[name]["documentation"].([]any); !ok || len(values) != 0 {
+			t.Fatalf("%s acquired documentation: %v", name, byName[name]["documentation"])
+		}
+	}
+}
