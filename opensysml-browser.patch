+// labEnrichAPIJSON adds facts from the already validated typed model. Modified
+// for the maintained Modeling Lab; unresolved identities stay unasserted.
+func labEnrichAPIJSON(model *cachedModel, document *cachedDocument, elements []map[string]any) {
+	semantic := model.symbolContext().Semantics
+	resolver := model.symbolContext().Resolver
+	byName := map[string][]map[string]any{}
+	byID := map[any]map[string]any{}
+	bySpan := map[string][]map[string]any{}
+	for _, el := range elements {
+		if name, ok := el["qualifiedName"].(string); ok {
+			byName[name] = append(byName[name], el)
+		}
+		byID[el["@id"]] = el
+		key := fmt.Sprintf("%v:%v:%s", el["sysx:sourceLine"], el["sysx:sourceColumn"], strings.ToLower(fmt.Sprint(el["@type"])))
+		bySpan[key] = append(bySpan[key], el)
+	}
+	identity := func(sym *symbols.Symbol) (any, bool) {
+		if sym == nil {
+			return nil, false
+		}
+		if sym.Name != "" {
+			if matches := byName[model.index.GetFQN(sym)]; len(matches) == 1 {
+				return matches[0]["@id"], true
+			}
+		}
+		if sym.DocName != document.source.Name() || sym.Decl == nil {
+			return nil, false
+		}
+		meta := semantic.MetaclassOf(sym)
+		if meta == nil {
+			return nil, false
+		}
+		pos := document.source.Lines().PosAt(sym.DeclSpan.Offset)
+		metaclass := meta.Name
+		// The pinned API-JSON encoder represents a verify clause as a
+		// RequirementUsage, while its typed AST is UsageSatisfy/verify.
+		if usage, ok := sym.Decl.(*ast.Usage); ok && usage.Kind == ast.UsageSatisfy && usage.Keyword == "verify" {
+			metaclass = "RequirementUsage"
+		}
+		key := fmt.Sprintf("%d:%d:%s", pos.Line, pos.Col, strings.ToLower(metaclass))
+		if matches := bySpan[key]; len(matches) == 1 {
+			return matches[0]["@id"], true
+		}
+		return nil, false
+	}
+	refs := func(syms []*symbols.Symbol) ([]map[string]any, []string) {
+		out := []map[string]any{}
+		missing := []string{}
+		seen := map[any]bool{}
+		for _, sym := range syms {
+			if id, ok := identity(sym); ok {
+				if !seen[id] {
+					out = append(out, map[string]any{"@id": id})
+					seen[id] = true
+				}
+			} else {
+				missing = append(missing, model.index.GetFQN(sym))
+			}
+		}
+		return out, missing
+	}
+	// Resolve original AST pointers, preserving each feature-chain occurrence.
+	var chainSymbols func(ast.Node) ([]*symbols.Symbol, bool)
+	chainSymbols = func(node ast.Node) ([]*symbols.Symbol, bool) {
+		switch n := node.(type) {
+		case *ast.FeatureReference:
+			return chainSymbols(n.Name)
+		case *ast.QualifiedName:
+			if n == nil || len(n.Parts) == 0 {
+				return nil, false
+			}
+			out := []*symbols.Symbol{}
+			for i := 1; i <= len(n.Parts); i++ {
+				if i == len(n.Parts) || n.Parts[i].Chained {
+					sym, ok := resolver.PartSymbol(n, i-1)
+					if !ok || sym == nil {
+						return nil, false
+					}
+					out = append(out, sym)
+				}
+			}
+			return out, true
+		case *ast.FeatureChainExpr:
+			out, ok := chainSymbols(n.Operand)
+			if !ok {
+				return nil, false
+			}
+			rest, ok := chainSymbols(n.Member)
+			if !ok {
+				return nil, false
+			}
+			return append(out, rest...), true
+		}
+		return nil, false
+	}
+	seen := map[*symbols.Symbol]bool{}
+	var all []*symbols.Symbol
+	var collect func(*symbols.Scope)
+	collect = func(scope *symbols.Scope) {
+		if scope == nil {
+			return
+		}
+		all = append(all, scope.AllMembers()...)
+		for _, child := range scope.Children() {
+			collect(child)
+		}
+	}
+	collect(model.index.DocumentRoot(document.source.Name()))
+	for _, sym := range all {
+		if sym == nil || seen[sym] || sym.DocName != document.source.Name() {
+			continue
+		}
+		seen[sym] = true
+		id, ok := identity(sym)
+		if !ok {
+			continue
+		}
+		el := byID[id]
+		if el == nil {
+			continue
+		}
+		for _, field := range []string{"isComposite", "isReference", "isAbstract", "isOrdered", "isUnique"} {
+			if value, ok := semantic.ReflectiveFeatureValue(sym, field); ok && value.Kind == symbols.FilterValueBool {
+				el[field] = value.Bool
+			}
+		}
+		switch el["@type"] {
+		case "StateDefinition", "StateUsage", "ExhibitStateUsage":
+			if value, ok := semantic.ReflectiveFeatureValue(sym, "isParallel"); ok && value.Kind == symbols.FilterValueBool {
+				el["isParallel"] = value.Bool
+			}
+		}
+		if features, ok := semantic.ReflectiveElements(sym, "feature"); ok {
+			local := []*symbols.Symbol{}
+			excluded := 0
+			for _, feature := range features {
+				if feature.DocName != document.source.Name() {
+					excluded++
+				} else {
+					local = append(local, feature)
+				}
+			}
+			mapped, missing := refs(local)
+			el["feature"] = mapped
+			el["featureLibraryExcluded"] = excluded
+			if len(missing) > 0 {
+				el["lab:unmappedFeatureRefs"] = missing
+			}
+		}
+		for _, field := range []string{"subjectParameter", "objectiveRequirement", "documentation"} {
+			if values, ok := semantic.ReflectiveElements(sym, field); ok {
+				mapped, missing := refs(values)
+				if len(missing) == 0 {
+					if len(mapped) == 1 && field != "documentation" {
+						el[field] = mapped[0]
+					} else {
+						el[field] = mapped
+					}
+				} else {
+					el["lab:unmapped:"+field] = missing
+				}
+			}
+		}
+		if usage, ok := sym.Decl.(*ast.Usage); ok && usage.Kind == ast.UsageSatisfy {
+			el["isNegated"] = usage.IsNegated
+			kind := semantics.RelationshipSatisfaction
+			if usage.Keyword == "verify" {
+				kind = semantics.RelationshipVerification
+			}
+			edges := semantic.RelationshipEdgesOf(sym, kind)
+			sources := []*symbols.Symbol{}
+			targets := []*symbols.Symbol{}
+			for _, edge := range edges {
+				sources = append(sources, edge.Source)
+				targets = append(targets, edge.Target)
+			}
+			sourceRefs, sourceMissing := refs(sources)
+			targetRefs, targetMissing := refs(targets)
+			if kind == semantics.RelationshipSatisfaction {
+				if len(sourceMissing) == 0 && len(sourceRefs) == 1 {
+					el["satisfyingFeature"] = sourceRefs[0]
+				}
+				if len(targetMissing) == 0 && len(targetRefs) == 1 {
+					el["satisfiedRequirement"] = targetRefs[0]
+				}
+			} else if len(targetMissing) == 0 && len(targetRefs) > 0 {
+				el["verifiedRequirement"] = targetRefs
+				// The typed edge source identifies the enclosing verification case,
+				// including verify usages declared inside an objective requirement.
+				for _, source := range sources {
+					if caseID, ok := identity(source); ok {
+						if target := byID[caseID]; target != nil && (target["@type"] == "VerificationCaseDefinition" || target["@type"] == "VerificationCaseUsage") {
+							existing, _ := target["verifiedRequirement"].([]map[string]any)
+							existing = append(existing, targetRefs...)
+							unique := []map[string]any{}
+							seen := map[any]bool{}
+							for _, ref := range existing {
+								if !seen[ref["@id"]] {
+									seen[ref["@id"]] = true
+									unique = append(unique, ref)
+								}
+							}
+							target["verifiedRequirement"] = unique
+						}
+					}
+				}
+			}
+			for _, rel := range usage.Relationships {
+				if rel == nil || rel.Kind != ast.RelSubject || rel.Target == nil {
+					continue
+				}
+				if _, ok := resolver.ResolveTarget(sym.OwnerScope, rel.Target); !ok {
+					continue
+				}
+				if symbols, ok := chainSymbols(rel.Target); ok {
+					// A chain is an ordered occurrence path, not a set of
+					// referenced declarations. Recursive steps may repeat an ID.
+					mapped := []map[string]any{}
+					complete := true
+					for _, step := range symbols {
+						id, ok := identity(step)
+						if !ok {
+							complete = false
+							break
+						}
+						mapped = append(mapped, map[string]any{"@id": id})
+					}
+					if complete && len(mapped) > 0 {
+						el["lab:subjectChain"] = mapped
+					}
+				}
+			}
+		}
+		if transition, ok := sym.Decl.(*ast.TransitionMember); ok {
+			complete := true
+			for _, field := range []struct {
+				name     string
+				declared bool
+			}{{"triggerAction", transition.Trigger != nil}, {"guardExpression", transition.Guard != nil}, {"effectAction", transition.HasEffect || len(transition.Effect) > 0}} {
+				if _, exists := el[field.name]; !exists {
+					if !field.declared {
+						el[field.name] = []any{}
+					} else {
+						complete = false
+					}
+				}
+			}
+			if complete {
+				el["lab:transitionFieldsComplete"] = true
+			}
+		}
+		if ends, ok := semantic.OwnedConnectorEnds(sym); ok {
+			encoded, _ := el["connectorEnd"].([]any)
+			if len(ends) == len(encoded) {
+				for i, nativeEnd := range ends {
+					ref, _ := encoded[i].(map[string]any)
+					target := byID[ref["@id"]]
+					roles := semantic.ImplicitEndRedefinitions(nativeEnd)
+					if target != nil && len(roles) == 1 {
+						target["lab:roleName"] = roles[0].Name
+					}
+				}
+			}
+		}
+	}
+}
