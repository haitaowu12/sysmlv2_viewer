+func TestLabAnonymousConnectorExactOrigin(t *testing.T) {
+	server, err := New("lab-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const source = `package LinkDemo {
+ port def Signal;
+ part def Device { port signal : Signal; }
+ part system {
+  part left : Device;
+  part right : Device;
+  connect left.signal to right.signal;
+ }
+}`
+	graph := labRender(t, server, source, "#interconnection:LinkDemo::system")
+	edges := graph["edges"].([]any)
+	if len(edges) != 1 {
+		t.Fatalf("want one anonymous connector: %v", edges)
+	}
+	origin := edges[0].(map[string]any)["origin"].(map[string]any)
+	if origin["startLine"] != float64(7) || origin["startCol"] != float64(3) || origin["endLine"] != float64(7) {
+		t.Fatalf("wrong connector span: %v", origin)
+	}
+	line := strings.Split(source, "\n")[6]
+	start := int(origin["startCol"].(float64)) - 1
+	end := int(origin["endCol"].(float64)) - 1
+	if got := line[start:end]; got != "connect left.signal to right.signal;" {
+		t.Fatalf("connector origin covers %q", got)
+	}
+}
