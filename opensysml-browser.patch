+func labRender(t *testing.T, server *Server, source, target string) map[string]any {
+	t.Helper()
+	request, _ := json.Marshal(map[string]any{"content": source, "strictConformance": true})
+	parsed, err := server.Call(context.Background(), "ParseFile", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result map[string]any
+	if err = json.Unmarshal(parsed, &result); err != nil {
+		t.Fatal(err)
+	}
+	if diagnostics, ok := result["diagnostics"].([]any); ok {
+		for _, raw := range diagnostics {
+			d := raw.(map[string]any)
+			if d["severity"] == "error" {
+				t.Fatalf("invalid fixture: %s", parsed)
+			}
+		}
+	}
+	request, _ = json.Marshal(map[string]any{"modelHash": result["modelHash"], "view": target, "ports": "full"})
+	rendered, err := server.Call(context.Background(), "RenderView", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal(rendered, &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
