+// SetContainmentDepth bounds both the suppression dry-run and containment walk.
+// The checked range cannot exceed the existing renderer safety bound.
+func (r *Renderer) SetContainmentDepth(depth int) error {
+	if depth < 1 || depth > maxTreeDepth {
+		return fmt.Errorf("containment depth must be between 1 and %d", maxTreeDepth)
+	}
+	r.treeDepthBound = depth
+	return nil
+}
