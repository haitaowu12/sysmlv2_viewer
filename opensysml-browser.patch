+func TestLabSubjectChainRetainsRepeatedFeatureSteps(t *testing.T) {
+	elements := labTestExport(t, `package Repeated {
+ part def Node { ref part next : Node; }
+ part root : Node;
+ requirement r { subject item : Node; require constraint { true } }
+ satisfy r by root.next.next;
+}`)
+	names := map[any]string{}
+	for _, el := range elements {
+		if name, ok := el["qualifiedName"].(string); ok {
+			names[el["@id"]] = name
+		}
+	}
+	found := false
+	for _, el := range elements {
+		if el["@type"] != "SatisfyRequirementUsage" {
+			continue
+		}
+		found = true
+		chain, ok := el["lab:subjectChain"].([]any)
+		if !ok || len(chain) != 3 {
+			t.Fatalf("recursive occurrence chain lost a step: %v", el["lab:subjectChain"])
+		}
+		expected := []string{"Repeated::root", "Repeated::Node::next", "Repeated::Node::next"}
+		for i, ref := range chain {
+			id := ref.(map[string]any)["@id"]
+			if names[id] != expected[i] {
+				t.Fatalf("chain step %d = %s, expected %s", i, names[id], expected[i])
+			}
+		}
+	}
+	if !found {
+		t.Fatal("fixture satisfaction declaration was not exported")
+	}
+}
