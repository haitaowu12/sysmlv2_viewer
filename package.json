{
  "name": "sysml-engineering-workbench",
  "private": true,
  "version": "0.7.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && npm run build:workbench && vite build",
    "build:workbench": "tsc -p tsconfig.workbench.json && node scripts/copy-workbench-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:workbench": "vitest run packages apps/workbench-service",
    "workbench:service": "node dist-workbench/apps/workbench-service/src/main.js",
    "workbench:service:dev": "tsx apps/workbench-service/src/main.ts",
    "workbench:companion": "npm run build:workbench && tsx scripts/workbench-launch-companion.ts",
    "companion:package": "tsx scripts/workbench-package-companion-safe.ts",
    "companion:smoke": "tsx scripts/workbench-smoke-companion-bundle.ts",
    "build:web-companion": "tsx scripts/workbench-build-web-companion.ts",
    "qualify:web-companion": "tsx scripts/workbench-qualify-web-companion.ts",
    "verify:web-companion": "npm run build:web-companion && npm run qualify:web-companion",
    "qualify:engines": "tsx scripts/workbench-qualify-engines.ts",
    "qualify:fixtures": "tsx scripts/workbench-qualify-fixtures.ts",
    "qualify:phase1-summary": "tsx scripts/workbench-summarize-phase1.ts",
    "qualify:phase2": "tsx scripts/workbench-qualify-phase2.ts",
    "qualify:phase3": "tsx scripts/workbench-qualify-phase3.ts",
    "qualify:service-product-shell-foundation": "tsx scripts/workbench-qualify-phase4.ts",
    "qualify:phase4": "npm run qualify:service-product-shell-foundation",
    "qualify:service-assurance-workflow": "tsx scripts/workbench-qualify-phase5.ts",
    "qualify:phase5": "npm run qualify:service-assurance-workflow",
    "qualify:phase6": "tsx scripts/workbench-qualify-phase6.ts",
    "qualify:recovery": "tsx scripts/workbench-qualify-recovery.ts",
    "benchmark:workbench": "tsx scripts/workbench-benchmark.ts",
    "release:inventory": "tsx scripts/workbench-release-inventory.ts",
    "release:license-policy": "tsx scripts/workbench-license-policy.ts",
    "release:runtime-provenance": "tsx scripts/workbench-runtime-provenance.ts",
    "release:init-evidence": "tsx scripts/workbench-init-release-evidence.ts",
    "release:validate-approval": "tsx scripts/workbench-validate-release-approval.ts",
    "release:package": "tsx scripts/workbench-package-release.ts",
    "desktop:stage": "tsx scripts/workbench-stage-desktop.ts",
    "desktop:check": "tsx scripts/workbench-prepare-desktop-check.ts && cargo check --manifest-path apps/workbench-desktop/src-tauri/Cargo.toml",
    "desktop:license": "tsx scripts/workbench-desktop-license-inventory.ts",
    "desktop:audit": "tsx scripts/workbench-desktop-security-audit.ts",
    "desktop:build:app": "tsx scripts/workbench-require-desktop-staging.ts && npm run build && tauri build --config apps/workbench-desktop/src-tauri/tauri.conf.json --bundles app",
    "desktop:build:dmg": "tsx scripts/workbench-require-desktop-staging.ts && npm run build && tauri build --config apps/workbench-desktop/src-tauri/tauri.conf.json --bundles app,dmg",
    "desktop:smoke": "tsx scripts/workbench-smoke-desktop-bundle.ts",
    "desktop:smoke:dmg": "tsx scripts/workbench-smoke-desktop-dmg.ts",
    "release:verify-bundle": "tsx scripts/workbench-verify-release-bundle.ts",
    "release:smoke-bundle": "tsx scripts/workbench-smoke-release-bundle.ts",
    "audit:production": "npm audit --omit=dev",
    "test:release": "vitest run src/test/releaseBaseline.test.ts src/test/upstreamCorpus.test.ts",
    "test:watch": "vitest",
    "verify:phase1": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:phase2": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:phase3": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:service-product-shell-foundation": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:phase4": "npm run verify:service-product-shell-foundation",
    "verify:service-assurance-workflow": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:phase5": "npm run verify:service-assurance-workflow",
    "verify:phase6": "npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production",
    "verify:gate-truth": "tsx scripts/workbench-validate-gate-truth.ts",
    "verify:release:source": "npm run verify:gate-truth && npm run lint && npm run test:workbench && npm run test && npm run build && npm run audit:production && npm run release:inventory -- --output generated/release-evidence --label phase7 && npm run release:license-policy -- --inventory generated/release-evidence/phase7-package-license-inventory.json --output generated/release-evidence/phase7-license-policy.json --allow-owner-blocker",
    "verify:release:technical": "npm run verify:release:source && tsx scripts/workbench-verify-release.ts --allow-owner-blockers",
    "verify:release": "npm run verify:release:source && tsx scripts/workbench-verify-release.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "peggy": "^5.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "tar": "^7.5.22",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "dompurify": "^3.4.0"
  }
}
